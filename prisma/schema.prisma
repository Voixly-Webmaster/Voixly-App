// LOCAL DEV SCHEMA (SQLite)
// Production uses prisma/schema.mysql.prisma (MySQL) — keep the models in both
// files in sync when you change anything here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_CLIENT
  STUCK
  SEND_TO_CLIENT
  COMPLETED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  WAITING
  RESOLVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          UserRole  @default(CLIENT)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  clientProfile   Client?
  staffProfile    StaffProfile?
  accounts        Account[]
  sessions        Session[]
  activityLogs    ActivityLog[] @relation("ActivityActor")
  ticketMessages  TicketMessage[]
  taskComments    TaskComment[]
  uploadedFiles   FileUpload[]  @relation("FileUploader")
  clientNotes     ClientNote[]  @relation("NoteAuthor")
  assignedTasks   Task[]        @relation("TaskAssignee")
  createdTasks    Task[]        @relation("TaskCreator")
  dailyWins       DailyWin[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id              String    @id @default(cuid())
  userId          String    @unique
  companyName     String
  contactName     String?
  phone           String?
  address         String?
  stripeCustomerId String?  @unique
  /** Card on file for automatic monthly charges of open invoices */
  autopayEnabled  Boolean   @default(false)
  stripePaymentMethodId String?
  autopayDay      Int       @default(1)
  autopayEnabledAt DateTime?
  balanceCents    Int       @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffAssignments StaffClientAssignment[]
  invoices        Invoice[]
  payments        Payment[]
  recurringInvoices RecurringInvoice[]
  tasks           Task[]
  supportTickets  SupportTicket[]
  fileUploads     FileUpload[]
  clientNotes     ClientNote[]
  announcements   AnnouncementClient[]
  activityLogs    ActivityLog[]
  googleIntegration ClientGoogleIntegration?

  @@index([companyName])
  @@index([deletedAt])
  @@map("clients")
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAssignments StaffClientAssignment[]

  @@map("staff_profiles")
}

model StaffClientAssignment {
  id        String   @id @default(cuid())
  staffId   String
  clientId  String
  createdAt DateTime @default(now())

  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([staffId, clientId])
  @@index([clientId])
  @@map("staff_client_assignments")
}

model RecurringInvoice {
  id                   String          @id @default(cuid())
  clientId             String
  title                String
  description          String?
  amountCents          Int
  interval             BillingInterval
  status               RecurringStatus @default(PENDING)
  stripeSubscriptionId String?         @unique
  stripePriceId        String?
  nextBillingAt        DateTime?
  cancelledAt          DateTime?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([clientId])
  @@index([status])
  @@map("recurring_invoices")
}

model Invoice {
  id                 String        @id @default(cuid())
  clientId           String
  recurringInvoiceId String?
  invoiceNumber      String        @unique
  title              String
  description        String?
  amountCents        Int
  status             InvoiceStatus @default(DRAFT)
  dueDate            DateTime?
  stripeInvoiceId    String?       @unique
  sentAt             DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  payments         Payment[]

  @@index([clientId])
  @@index([recurringInvoiceId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("invoices")
}

model Payment {
  id                    String        @id @default(cuid())
  clientId              String
  invoiceId             String?
  amountCents           Int
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeCheckoutSessionId String?     @unique
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([invoiceId])
  @@map("payments")
}

model Task {
  id              String     @id @default(cuid())
  clientId        String?
  title           String
  description     String?
  status          TaskStatus @default(NEW)
  priority        String     @default("medium")
  scheduledDate   DateTime   @default(now())
  dueDate         DateTime?
  completed       Boolean    @default(false)
  clientVisible   Boolean    @default(false)
  assigneeId      String?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User          @relation("TaskCreator", fields: [createdById], references: [id])
  comments  TaskComment[]

  @@index([clientId])
  @@index([status])
  @@index([assigneeId])
  @@index([scheduledDate])
  @@index([dueDate])
  @@index([completed])
  @@index([clientVisible])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

model SupportTicket {
  id        String       @id @default(cuid())
  clientId  String
  subject   String
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?
  deletedAt DateTime?

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

model FileUpload {
  id           String   @id @default(cuid())
  clientId     String?
  uploadedById String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  path         String
  clientVisible Boolean @default(true)
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  uploadedBy User    @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("file_uploads")
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([clientId])
  @@index([deletedAt])
  @@map("client_notes")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  published Boolean  @default(false)
  publishAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  clients AnnouncementClient[]

  @@index([published])
  @@index([deletedAt])
  @@map("announcements")
}

model AnnouncementClient {
  id             String   @id @default(cuid())
  announcementId String
  clientId       String?
  readAt         DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([announcementId])
  @@map("announcement_clients")
}

model DailyWin {
  id        String   @id @default(cuid())
  text      String
  goalDate  DateTime
  userId    String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalDate])
  @@index([userId])
  @@index([completed])
  @@map("daily_wins")
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  clientId   String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor  User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([actorId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model ClientGoogleIntegration {
  id                 String    @id @default(cuid())
  clientId           String    @unique
  refreshToken       String
  accessToken        String?
  expiresAt          DateTime?
  googleEmail        String?
  gaPropertyId       String?
  gaPropertyName     String?
  searchConsoleSite  String?
  clientVisible      Boolean   @default(true)
  connectedById      String
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_google_integrations")
}
