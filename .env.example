# App
NEXTAUTH_URL="http://localhost:3010"
NEXTAUTH_SECRET="generate-a-strong-secret-here"
AUTH_SECRET="same-value-as-NEXTAUTH_SECRET"
APP_URL="http://localhost:3010"

# Local dev (SQLite — works out of the box)
DATABASE_URL="file:./dev.db"

# Production (MySQL)
# DATABASE_URL="mysql://user:password@localhost:3306/clienthub"

# Stripe — optional here; can also be set in Admin → Settings → Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend — optional here; can also be set in Admin → Settings → Email
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="ClientHub <notifications@yourdomain.com>"

# Google Analytics + Search Console — optional here; can also be set in
# Admin → Settings → Integrations
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File uploads (private storage — served via /api/files)
UPLOAD_DIR="storage/uploads"
