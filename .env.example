# =============================================================================
# Local development (SQLite)
# =============================================================================
NEXTAUTH_URL="http://localhost:3010"
NEXTAUTH_SECRET="generate-a-strong-secret-here"
AUTH_SECRET="same-value-as-NEXTAUTH_SECRET"
APP_URL="http://localhost:3010"
DATABASE_URL="file:./dev.db"

# =============================================================================
# Hostinger production — set these in hPanel → Environment variables
# (do not commit real values). Import this file there, then replace placeholders.
# =============================================================================
#
# Required
# --------
# NODE_ENV=production
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Or (easier on Hostinger — paste the raw DB password):
# MYSQL_HOST=localhost
# MYSQL_USER=u935498615_34982458_4645
# MYSQL_PASSWORD=
# MYSQL_DATABASE=u935498615_34982458_4678
# AUTH_SECRET=long-random-string
# NEXTAUTH_SECRET=same-as-AUTH_SECRET
# AUTH_URL=https://app.voixly.com
# NEXTAUTH_URL=https://app.voixly.com
# APP_URL=https://app.voixly.com
#
# First admin (only used when the users table is empty)
# ------------------------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=you@voixly.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# BOOTSTRAP_ADMIN_NAME=Admin
#
# Resend (transactional email — invoices + tickets)
# --------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Voixly <notifications@voixly.com>
#
# Stripe (or set later in Admin → Settings → Payments)
# -----------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Google Insights (or set later in Admin → Settings → Integrations)
# -----------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Optional
# --------
# UPLOAD_DIR=storage/uploads
# CRON_SECRET=random-string-for-daily-autopay

# Stripe — optional here; can also be set in Admin → Settings → Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Resend — optional here; can also be set in Admin → Settings → Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ClientHub <onboarding@resend.dev>"

# Google Analytics + Search Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File uploads (private storage — served via /api/files)
UPLOAD_DIR="storage/uploads"

# Optional: protect /api/cron/autopay (daily schedule recommended)
# CRON_SECRET="generate-a-random-string"
